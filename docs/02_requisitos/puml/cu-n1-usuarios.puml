@startuml CU-N1-Usuarios
' Nivel 1 - Expande: Gestionar usuarios
title CU Nivel 1 - Gestionar usuarios
left to right direction

actor "Administrador" as ADM

rectangle "Gestionar usuarios" {
  usecase "Consultar y buscar usuarios" as U1
  usecase "Crear usuario administrativo" as U2
  usecase "Asignar o modificar rol" as U3
  usecase "Suspender o desactivar usuario" as U4
  usecase "Suspender prestador" as U5
  usecase "Restablecer contrasena" as U6
  usecase "Registrar accion en auditoria" as U7
}

ADM --> U1
ADM --> U2
ADM --> U3
ADM --> U4
ADM --> U5
ADM --> U6

U2 ..> U7 : <<include>>
U3 ..> U7 : <<include>>
U4 ..> U7 : <<include>>

note right of U4
  RF-081: no auto-desactivarse
end note
@enduml
