@startuml CU-N1-Indicadores
' Nivel 1 - Expande: Consultar indicadores del destino
title CU Nivel 1 - Consultar indicadores del destino
left to right direction

actor "Gestor Destino" as GES
actor "Administrador" as ADM

rectangle "Consultar indicadores del destino" {
  usecase "Consultar congestion y capacidad de carga" as I1
  usecase "Consultar demanda y ocupacion" as I2
  usecase "Analizar impacto de recomendaciones" as I3
  usecase "Generar reporte" as I4
  usecase "Consultar reportes" as I7
  usecase "Exportar reporte" as I5
  usecase "Filtrar reportes" as I6
}

GES --> I1
GES --> I2
GES --> I3
GES --> I4
GES --> I7
ADM --> I4
ADM --> I7

I5 ..> I4 : <<extend>>
I5 ..> I7 : <<extend>>
I6 ..> I4 : <<extend>>
I6 ..> I7 : <<extend>>
@enduml
